---
layout: null
---
[{% for note in site.notes %}{% assign category = site.data.categories | where: 'id', note.category | first %}{"title":{{ note.title | jsonify }},"url":{{ note.url | relative_url | jsonify }},"category":{{ category.name | default: '随记' | jsonify }},"description":{{ note.description | default: '' | jsonify }},"tags":{{ note.tags | join: ' ' | jsonify }},"content":{{ note.content | strip_html | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
